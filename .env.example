# ---------- Backend (backend/.env) ----------
DATABASE_URL=postgresql://certiledger:change_me@localhost:5432/certiledger
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Polygon (use Amoy testnet for development)
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_ID=80002
PRIVATE_KEY=0xYOUR_ISSUER_WALLET_PRIVATE_KEY   # never commit a real key
CONTRACT_ADDRESS=0xDEPLOYED_CONTRACT_ADDRESS

# IPFS (pinning service)
IPFS_API_URL=https://api.pinata.cloud
IPFS_PINNING_KEY=your-pinning-api-key
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# ---------- Frontend (frontend/.env) ----------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_VERIFY_BASE_URL=http://localhost:5173/verify
